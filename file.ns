// v5.0 Advanced Paninian Grammar Test
अस्ति संदेशः = "नमस्ते! यह नव संस्कृतम् v5.0 है।";
वद(संदेशः);

अस्ति कः = २०; // Nominative (Karta)
10 अस्ति खम्; // Accusative (Karma)

विधिः योग(अ, ब) {
    फलम् अ + ब;
}

वद(खम्);
वद(योग(कः, खम्));

// Dependency logic test
यदि (कः > खम्) तर्हि {
    वद("विषयः: कः खम्-तः विशालः अस्ति। (True: K is greater than KH)");
}

वद("चक्रम् (Loop) १-३:");
चक्र (i = १; i < ४; i = i + १) {
    वद(i);
}
