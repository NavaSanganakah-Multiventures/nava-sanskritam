// SUL v13.0 - True Paninian Grammatical Test
// Testing Sup (Vibhakti), Tin (Lakara), and Karaka Mapping

// 1. Prathama (Su-Pratyaya) -> Independent Variable (Karta)
अस्ति रामः = १००;
अस्ति कृष्णः = २००;

// 2. Dwitiya (Am-Pratyaya) -> Target Data (Karma)
अस्ति सन्देशम् = "नमस्ते नव-संस्कृतम्!";

// 3. Saptami (Ngi-Pratyaya) -> Address Pointer (Adhikarana)
अस्ति कोषे = { रत्नम्: ९९९ };

// 4. Tin-Anta: Lat-Lakara (Present Tense - Synchronous)
// Rule: Root 'पठ्' + 'ति' (Suffix)
विधिः पठति(ज्ञानम्) {
    वद(ज्ञानम्);
}

// 5. Tin-Anta: Lṛṭ-Lakara (Future Tense - Asynchronous)
// Rule: Root 'वद्' + 'इष्यति' (Suffix)
विधिः वदिष्यति(वचनम्) {
    वद(वचनम्);
}

// --- Execution Pass ---

पठति(रामः);               // Call with Karta (Prathama)
वदिष्यति(सन्देशम्);        // Async Call with Karma (Dwitiya)

वद(कोषे_रत्नम्);          // Memory Access via Adhikarana
वद(रामः + कृष्णः);       // Arithmetic with Declinable variables
