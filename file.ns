अस्ति संदेश = "नमस्ते! यह नव संस्कृतम् भाषा है।";
वद(संदेश);

अस्ति क = ५;
अस्ति ख = १०;

विधिः योग(अ, ब) {
    फलम् अ + ब;
}

वद("क और ख का योग है:");
वद(योग(क, ख));

यदि (क < ख) तर्हि {
    वद("क, ख से छोटा है। सत्यम्!");
} अन्यथा {
    वद("क, ख से बड़ा है। असत्यम्!");
}

वद("१ से ३ तक चक्र (Loop):");
चक्र (i = १; i < ४; i = i + १) {
    वद(i);
}
