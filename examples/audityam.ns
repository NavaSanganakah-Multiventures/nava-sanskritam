// --- नव्या-सङ्कृतम् गहन-निरीक्षणम् (NVC Audit) ---

// १. नित्य-चर-निरीक्षणम् (Constant Check)
नित्य गुरु = "भगवान्";
वद("गुरुः अस्ति:", गुरु);

// अत्र दोषः भविष्यति (This should fail if enabled)
// गुरु = "मानवः"; 

// २. गणित-पुस्तकालय-निरीक्षणम् (Math Library Check)
अस्ति पञ्च = ५;
अस्ति वर्गफलम् = वर्गः(पञ्च);
वद("५ इत्यस्य वर्गः:", वर्गफलम्);

// ३. त्रैराशिकम् (Rule of Three)
// यदि १० रूप्यकैः ५ आम्रफलानि मिलन्ति, तर्हि २० रूप्यकैः कति?
अस्ति फलानि = त्रैराशिकम्(१०, ५, २०);
वद("२० रूप्यकैः आम्रफलानि:", फलानि);

// ४. नियम-निरीक्षणम् (Assertion)
नियमः(वर्गफलम् == २५, "गणितं सम्यक् नास्ति!");
वद("✅ सर्वे नियमाः शुद्धाः सन्ति!");
