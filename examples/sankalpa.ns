नित्य आचार्यः = "धीरेन्द्र त्रिपाठी";
नित्य मिशनम् = "नवा संस्कृतम्";
अस्ति सफलता_अंकः = १०८;

विधिः स्वागतम्(नाम) {
    वद("नमस्ते " + नाम + "!");
    फलम् १;
}

वद(आचार्यम्);
वद(मिशनम्);

अस्ति रक्षितम् = स्वागतम्(आचार्ये);

यदि (सफलता_अंकः > १००) तर्हि {
    वद("V2 इंजिन (पाणिनी-लॉजिक) सक्रिय अस्ति!");
} अन्यथा {
    वद("प्रयासं कुरुत।");
}

चक्र (i = १; i < ४; i = i + १) {
    वद("जयतु संस्कृतम् - " + i);
}