{
    "Manjusha Container": {
        "prefix": ["manjusha", "मंजूषा"],
        "body": [
            "मंजूषा ${1:नाम} {",
            "\t$0",
            "}"
        ],
        "description": "Creates a Manjusha container for Nava Framework"
    },
    "Darshanam View": {
        "prefix": ["darshanam", "दर्शनम्"],
        "body": [
            "दर्शनम् ${1:नित्यम्_वेबसाइट} {",
            "\t$0",
            "}"
        ],
        "description": "Creates a Darshanam view for Nava Framework"
    },
    "Drishyam Component": {
        "prefix": ["drishyam", "दृश्यम्"],
        "body": [
            "दृश्यम् ${1:पाठः}() {",
            "\tनाम: \"${2:पाठ}\";",
            "\t$0",
            "}"
        ],
        "description": "Creates a Drishyam UI component"
    },
    "Yadi Condition": {
        "prefix": ["yadi", "यदि"],
        "body": [
            "यदि (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "Yadi (If) conditional block"
    },
    "Tarhi Else": {
        "prefix": ["tarhi", "तर्हि"],
        "body": [
            "तर्हि {",
            "\t$0",
            "}"
        ],
        "description": "Tarhi (Else) block"
    },
    "Chakra Loop": {
        "prefix": ["chakra", "चक्र"],
        "body": [
            "चक्र (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "Chakra (While/Loop) block"
    },
    "Asti Variable": {
        "prefix": ["asti", "अस्ति"],
        "body": [
            "अस्ति ${1:variable_name} = ${2:value};"
        ],
        "description": "Asti (Variable declaration)"
    },
    "Vada Print": {
        "prefix": ["vada", "वद"],
        "body": [
            "वद(\"${1:message}\");"
        ],
        "description": "Vada (Print) statement"
    },
    "Suchi List": {
        "prefix": ["suchi", "सूची"],
        "body": [
            "सूची ${1:नाम} {",
            "\t$0",
            "}"
        ],
        "description": "Suchi (List) component"
    },
    "Chitram Image": {
        "prefix": ["chitram", "चित्त्रम्"],
        "body": [
            "दृश्यम् चित्त्रम्() {",
            "\tस्रोतस: \"${1:url}\";",
            "\tनाम: \"${2:alt_text}\";",
            "\t$0",
            "}"
        ],
        "description": "Chitram (Image) component"
    },
    "Pravishti Form": {
        "prefix": ["pravishti", "प्रविष्टिः"],
        "body": [
            "दृश्यम् प्रविष्टिः() {",
            "\tनाम: \"${1:placeholder}\";",
            "\t$0",
            "}"
        ],
        "description": "Pravishti (Input Form) component"
    },
    "Batanam Button": {
        "prefix": ["batanam", "बटनम्"],
        "body": [
            "दृश्यम् बटनम्() {",
            "\tनाम: \"${1:label}\";",
            "\tरङ्गः: ${2:नीलवर्णः};",
            "\t$0",
            "}"
        ],
        "description": "Batanam (Button) component"
    },
    "Praveshaya Login Sup Pratyaya": {
        "prefix": ["praveshaya", "प्रवेशाय", "login"],
        "body": [
            "मंजूषा प्रवेश-खण्डः {",
            "\tदृश्यम् पाठः() { नाम: \"लॉगिन (Login)\"; }",
            "\tदृश्यम् प्रविष्टिः() { नाम: \"उपयोगकर्ता (Username)\"; }",
            "\tदृश्यम् प्रविष्टिः() { नाम: \"गुप्तशब्दः (Password)\"; }",
            "\tदृश्यम् बटनम्() {",
            "\t\tनाम: \"प्रविश (Enter)\";",
            "\t\tरङ्गः: नीलवर्णः;",
            "\t\tक्रिया: प्रवेशाय;",
            "\t}",
            "\t$0",
            "}"
        ],
        "description": "Auto-generates a semantic Login Form using Sup Pratyaya logic (Chaturthi Vibhakti 'for login')"
    }
}
